<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#DD000000"
    android:padding="16dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/cyan_peacock"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/drawer_mascot"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_launcher_foreground"
            app:tint="@color/cyan_peacock"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_header"
                android:textColor="@color/cyan_peacock"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fortune_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cyan_peacock"
                android:textSize="16sp"
                android:textStyle="italic"
                android:alpha="1.0"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_hint"
        android:textColor="@color/cyan_peacock"
        android:textColorHint="#8800E5FF"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/search_bar_background"
        android:maxLines="1"
        android:inputType="text"
        android:autofillHints="name" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appDrawer_recylerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>